{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=monitor_ai;Username=monitor_app"
  },

  // Required Catalog search policy. Neither tolerance has a default, because docs/PLAN.md and
  // docs/TECHNICAL.md define them without defining their numbers, so the host refuses to start
  // until both are supplied explicitly:
  //
  //   Catalog:Search:SizeToleranceInches   <-  Catalog__Search__SizeToleranceInches
  //   Catalog:Search:SoftBudgetTolerance   <-  Catalog__Search__SoftBudgetTolerance
  //
  // Supply them with dotnet user-secrets or the environment variables above; the workflow is
  // documented in docs/CONFIGURATION.md. No numeric policy value is committed here.
  "Catalog": {
    "Search": {}
  },

  // The frozen Controlled Demo Candidate of docs/TECHNICAL.md section 8.2. It is deliberately not a
  // general benchmark pass, and these are the measured values, so the host rejects a different model,
  // timeout, temperature or context size at startup. Local Ollama needs no secret; never expose it
  // publicly. Environment variables follow the same names, for example Ai__Model.
  "Ai": {
    "Provider": "Ollama",
    "BaseUrl": "http://127.0.0.1:11434",
    "Model": "qwen3.5:2b-q4_K_M",
    "TimeoutSeconds": 20,
    "Temperature": 0,
    "ContextTokens": 4096
  }
}
