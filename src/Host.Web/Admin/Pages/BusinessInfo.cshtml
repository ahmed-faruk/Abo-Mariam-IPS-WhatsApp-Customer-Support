@page "/admin/business-info"
@model BusinessInfoModel
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <title>Admin Lite — Business info</title>
</head>
<body>
  <nav><a href="/admin/catalog">Catalog</a> | <a href="/admin/business-info">Business info</a> | <a href="/admin/conversations">Conversations</a></nav>
  <h1>Business info</h1>
  <table border="1" cellpadding="6">
    <thead><tr><th>Key</th><th>Answer (AR)</th></tr></thead>
    <tbody>
      @foreach (var row in Model.Rows)
      {
        <tr>
          <td>@row.Key</td>
          <td>@(row.Value?.AnswerAr ?? "(غير متاح)")</td>
        </tr>
      }
    </tbody>
  </table>
</body>
</html>
